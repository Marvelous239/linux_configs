// Place your key bindings in this file to override the defaults
[
    // Get here faster
    {
        "key": "ctrl+shift+k ctrl+shift+s",
        "command": "workbench.action.openGlobalKeybindingsFile",
        "when": "editorFocus || terminalEditorFocus"
    },
    
    // Custom keybindings for navigating and moving editor groups
    {
        "key": "ctrl+up",
        "command": "workbench.action.previousEditor",
        "when": "editorFocus || terminalEditorFocus"
    },
    {
        "key": "ctrl+down",
        "command": "workbench.action.nextEditor",
        "when": "editorFocus || terminalEditorFocus"
    },
    {
        "key": "alt+up",
        "command": "workbench.action.moveEditorLeftInGroup",
        "when": "editorFocus"
    },
    {
        "key": "alt+down",
        "command": "workbench.action.moveEditorRightInGroup",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+up",
        "command": "workbench.action.previousSideBarView",
        "when": "sideBarFocus"
    },
    {
        "key": "ctrl+down",
        "command": "workbench.action.nextSideBarView",
        "when": "sideBarFocus"
    },
    // ctrl+down comm wb.a.nextPanelView when panelFocus
    // ctrl+up comm wb.a.previousPanelView when panelFocus
    // ctrl+left comm wb.files.a.collapseExplorerFolders when explorerViewletFocus
    // ctrl+shift+left comm wb.a.focusLeftGroup when editorTextFocus
    // ctrl+shift+right comm wb.a.focusRightGroup when editorTextFocus
    // ctrl+shift+up comm wb.a.focusAboveGroup when editorTextFocus
    // ctrl+shift+down comm wb.a.focusBelowGroup when editorTextFocus

    // Tmux style keybindings for focusing different areas of the workbench
    {
        "key": "ctrl+a left",
        "command": "workbench.action.focusSideBar",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+a left",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "!sideBarFocus && !editorFocus"
    },
    {
        "key": "ctrl+a right",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "sideBarFocus"
    },
    {
        "key": "ctrl+a right",
        "command": "workbench.action.focusAuxiliaryBar",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+a down",
        "command": "workbench.action.focusPanel"
    },
    {
        "key": "ctrl+a up",
        "command": "workbench.action.focusActiveEditorGroup"
    },
    // ctrl+a shift+\\ comm wb.a.newGroupRight when editorFocus
    // ctrl+a shift+- comm wb.a.newGroupBelow when editorFocus
    // ctrl+a z comm wb.a.toggleMaximizedEditorGroup when editorPartMaximizedEditorGroup || editorPartMultipleEditorGroups
    // -ctrl+k ctrl+m

    // Override Ctrl+d to close the sidebar, auxiliary bar, or bottom panel depending on the context
    {
        "key": "ctrl+d",
        "command": "-editor.action.addSelectionToNextFindMatch",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+d",
        "command": "-notebook.addFindMatchToSelection",
        "when": "config.notebook.multiCursor.enabled && notebookCellEditorFocused && activeEditor == 'workbench.editor.notebook'"
    },
    {
        "key": "ctrl+d",
        "command": "-extension.vim_ctrl+d",
        "when": "editorTextFocus && vim.active && vim.use<C-d> && !inDebugRepl"
    },
    {
        "key": "ctrl+d",
        "command": "-list.focusPageDown",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+d",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "sideBarFocus"
    },
    {
        "key": "ctrl+d",
        "command": "workbench.action.toggleAuxiliaryBar",
        "when": "auxillaryBarFocus"
    },
    {
        "key": "ctrl+d",
        "command": "workbench.action.togglePanel",
        "when": "panelFocus"
    }
    // ctrl+d comm wb.a.closeEditorsAndGroup when activeEditorGroupEmpty

    // Vim extension
    // Remove vim ctrl f,p,k,s,e,y,n
    // ctrl+e comm editorScrool args (to: down, by: wrappedLine, value: 1, revealCursor: true) when editorTextFocus
    // ctrl+y comm editorScrool args (to: up, by: wrappedLine, value: 1, revealCursor: true) when editorTextFocus
    // ctrl+n comm editor.a.triggerSuggest when editorTextFocus && !suggestWidgetVisible
    // ctrl+n comm selectNextSuggestion when suggestWidgetVisible
    // ctrl+p comm editor.a.triggerSuggest when editorTextFocus && !suggestWidgetVisible
    // ctrl+p comm selectPrevSuggestion when suggestWidgetVisible

    // Vim leader strokes
    // , s w comm actions.find when editorTextFocus && vim.mode == 'Visual'
]
